# Montara environment example.
#
# Copy this file to .env and fill in only what you want to use.
# Empty values are safe. Montara is local-first and will fall back when keys are
# absent.
#
# Never commit .env, auth states, service accounts, model weights, or private
# generated media.

# ---------------------------------------------------------------------------
# Demo-friendly free or local defaults
# ---------------------------------------------------------------------------

# Built-in OS/system voice preference for public demos and zero-credit runs.
# Supported local preference in current demo flow: system
MONTARA_TTS_PROVIDER=system

# Free stock footage and images.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional cloud STT/captions for Shorts/reels.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional local model/network opt-in for keyless providers such as Wikimedia.
MONTARA_NETWORK=

# ---------------------------------------------------------------------------
# Provider live-audit safety
# ---------------------------------------------------------------------------

# Keep unset for normal development. Set to 1 only when you explicitly want
# montara providers smoke <id> --live to make a real network/provider request.
MONTARA_LIVE_PROVIDER_SMOKE=

# ---------------------------------------------------------------------------
# Cloud video generation providers
# Request builders and redaction are tested offline. Real generations require
# BYOK live smoke and provider billing/credits.
# ---------------------------------------------------------------------------

KLING_API_KEY=
RUNWAY_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_KEY=
MINIMAX_API_KEY=
HEYGEN_API_KEY=

# ---------------------------------------------------------------------------
# Cloud image providers
# ---------------------------------------------------------------------------

BFL_API_KEY=
OPENAI_API_KEY=
RECRAFT_API_KEY=
FAL_KEY=

# GEMINI_API_KEY also powers Google Gemini image/Veo request builders.

# ---------------------------------------------------------------------------
# Cloud TTS, music, and SFX
# ---------------------------------------------------------------------------

ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
SUNO_API_KEY=

# Doubao Speech is used by the Python/skills layer for Mandarin narration.
DOUBAO_SPEECH_API_KEY=
DOUBAO_SPEECH_VOICE_TYPE=

# ---------------------------------------------------------------------------
# Native composition / render toggles
# ---------------------------------------------------------------------------

# Prefer native Remotion for make/render when remotion-composer dependencies are
# installed. Without this, FFmpeg remains the honest universal floor.
REMOTION_ENABLED=

# Optional command/runtime paths.
BLENDER_BIN=
MANIM_BIN=

# ---------------------------------------------------------------------------
# Local generation runtimes
# Montara does not vendor these runtimes or model weights. Install them
# externally and point Montara at the local URL/command.
# ---------------------------------------------------------------------------

COMFYUI_URL=http://127.0.0.1:8188
A1111_URL=http://127.0.0.1:7860
PIPER_BIN=

# Faster Whisper / Transformers.js model/cache hints.
FASTER_WHISPER_MODELS=
TRANSFORMERS_CACHE=
MONTARA_VISION_MODELS=

# Legacy/local GPU video-generation switches used by parts of the Python tool
# layer and docs. These are runtime-gated, not required for normal demos.
VIDEO_GEN_LOCAL_ENABLED=
VIDEO_GEN_LOCAL_MODEL=

# Optional self-hosted Modal LTX endpoint.
MODAL_LTX2_ENDPOINT_URL=

# Optional root for managed external runtimes. Defaults to a user-local
# directory when unset.
MONTARA_RUNTIMES_DIR=
