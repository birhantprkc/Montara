{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "montara:pipeline",
  "title": "Montara Pipeline Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "blurb",
    "palette",
    "beats"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "blurb": {
      "type": "string"
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "weight"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
