{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "montara:scene-plan",
  "title": "Montara ScenePlan",
  "type": "object",
  "required": [
    "width",
    "height",
    "fps",
    "scenes"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "fps": {
      "type": "integer",
      "minimum": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "durationSec"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "durationSec": {
            "type": "number",
            "minimum": 0
          },
          "background": {
            "type": "string"
          }
        }
      }
    }
  }
}
