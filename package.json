{
  "name": "montara",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "montara": "esbuild packages/cli/src/index.ts --bundle --platform=node --format=esm --outfile=packages/cli/.montara.mjs && node packages/cli/.montara.mjs",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=scripts/.verify.mjs && node scripts/.verify.mjs",
    "doctor": "esbuild scripts/doctor.ts --bundle --platform=node --format=esm --outfile=scripts/.doctor.mjs && node scripts/.doctor.mjs",
    "validate": "esbuild scripts/validate.ts --bundle --platform=node --format=esm --outfile=scripts/.validate.mjs && node scripts/.validate.mjs",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@montara/agent": "workspace:*",
    "@montara/cli": "workspace:*",
    "@montara/core": "workspace:*",
    "@montara/providers": "workspace:*",
    "@montara/quality": "workspace:*",
    "@montara/research": "workspace:*",
    "@montara/render-engines": "workspace:*",
    "@montara/render-ffmpeg": "workspace:*",
    "@montara/render-remotion": "workspace:*",
    "@montara/style": "workspace:*",
    "@montara/understand": "workspace:*",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3"
  }
}
