{
  "name": "montara",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=scripts/.verify.mjs && node scripts/.verify.mjs",
    "doctor": "esbuild scripts/doctor.ts --bundle --platform=node --format=esm --outfile=scripts/.doctor.mjs && node scripts/.doctor.mjs",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@montara/core": "workspace:*",
    "@montara/render-ffmpeg": "workspace:*",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3"
  }
}
